rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    // Public website may submit a pending application only. Public users
    // cannot read, edit, approve or delete applications.
    match /admissionApplications/{applicationId} {
      allow create: if request.auth == null
        && request.resource.data.status == 'pending'
        && request.resource.data.nameEn is string
        && request.resource.data.nameEn.size() <= 120
        && request.resource.data.nameBn is string
        && request.resource.data.nameBn.size() <= 120
        && request.resource.data.guardianName is string
        && request.resource.data.guardianMobile is string
        && request.resource.data.admissionClass is string
        && request.resource.data.academicYear is string
        && request.resource.data.applicationNo is string
        && request.resource.data.photoData is string
        && request.resource.data.photoData.size() <= 500000;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
